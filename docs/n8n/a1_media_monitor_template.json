{
  "name": "AgroPILOT A1 — медиа-мониторинг (§20)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Раз в час",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://mdked.hlab.kz/agropilot/api/v1/auth/refresh",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"refresh_token\": \"{{$env.AGROPILOT_SERVICE_REFRESH}}\"}",
        "options": {}
      },
      "id": "refresh",
      "name": "Обновить сервисный JWT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mdked.hlab.kz/agropilot/api/v1/news/scan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.data?.access_token || $env.AGROPILOT_SERVICE_TOKEN}}"
            }
          ]
        },
        "options": {}
      },
      "id": "scan",
      "name": "POST /v1/news/scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "failcheck",
      "name": "Ошибка сканирования?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.ADMIN_TG_CHAT_ID }}",
        "text": "=A1 не смог просканировать источники: {{ JSON.stringify($json) }}",
        "additionalFields": {}
      },
      "id": "notify",
      "name": "Уведомить админа",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        -100
      ]
    }
  ],
  "connections": {
    "Раз в час": {
      "main": [
        [
          {
            "node": "Обновить сервисный JWT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Обновить сервисный JWT": {
      "main": [
        [
          {
            "node": "POST /v1/news/scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /v1/news/scan": {
      "main": [
        [
          {
            "node": "Ошибка сканирования?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ошибка сканирования?": {
      "main": [
        [
          {
            "node": "Уведомить админа",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Каркас A1 (§20). НЕ активировать до реализации POST /v1/news/scan (Этап 2)."
  },
  "id": "AgroPILOTA1MediaMonitor"
}