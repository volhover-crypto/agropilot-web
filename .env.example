# .env.example — AgroPILOT backend environment variables
# Copy to .env and fill in real values. Never commit .env to git.

# PostgreSQL async connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/agropilot

# JWT settings (placeholder — replace before production)
SECRET_KEY=CHANGEME_replace_with_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Таймзона по умолчанию (О4): «голые» времена без offset, расписания BFF.
# Не зона хоста. systemd/n8n на сервере настроены на ту же зону.
DEFAULT_TZ=Europe/Moscow

# LLM-шлюз (§24, OpenRouter)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SEC=60

# Telegram: бот JARVIS_MONITOR (входящие A4 + согласования §35, polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_INBOX_AUTOCLASSIFY=1
# Сервисная учётка для сервисных входов бота (tg_poller, send_digest)
U7_PASSWORD=
# Базовый URL BFF для сервисных скриптов
AGROPILOT_BASE=http://127.0.0.1:8000/agropilot/api/v1

# MIA-продюсер полевого мониторинга (§34)
MIA_MODE=info
MIA_DEDUP_MINUTES=60
MOCK_BASE_URL=http://127.0.0.1:5599

# Вопросы агента ПЕТРУШКИ (§40): TTL вопроса в часах
AGENT_QUESTION_TTL=72
